{
  "info": {
    "name": "Quadra Livre API",
    "description": "Coleção de testes da API Quadra Livre.\n\nOrdem recomendada: executar a coleção inteira pelo Collection Runner. Os IDs de jogador, quadra e reserva são salvos automaticamente.",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333/api",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "playerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "courtId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "playerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "courtName",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalidId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Confirma que a API está online."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Resposta em JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Campo success igual a true\", function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test(\"Campo message presente\", function () { pm.expect(body).to.have.property(\"message\"); });",
                  "pm.test(\"Timestamp presente\", function () { pm.expect(body.data).to.have.property(\"timestamp\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Players",
      "item": [
        {
          "name": "Criar jogador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/players",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pedro Teste {{runId}}\",\n  \"email\": \"{{playerEmail}}\",\n  \"phone\": \"(85) 99999-9999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"playerEmail\", `pedro.teste.${runId}@email.com`);",
                  "pm.collectionVariables.set(\"courtName\", `Arena Teste ${runId}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Resposta em JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"Campo success igual a true\", function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test(\"Campo message presente\", function () { pm.expect(body).to.have.property(\"message\"); });",
                  "pm.test(\"Jogador retornado com ID\", function () { pm.expect(body.data).to.have.property(\"id\"); });",
                  "pm.collectionVariables.set(\"playerId\", body.data.id);",
                  "pm.test(\"E-mail retornado corretamente\", function () { pm.expect(body.data.email).to.eql(pm.collectionVariables.get(\"playerEmail\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar jogadores",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/players"
          },
          "event": [
